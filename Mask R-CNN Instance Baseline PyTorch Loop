import os
import cv2
import torch
import numpy as np
import torchvision
from torchvision.models.detection.faster_rcnn import FastRCNNPredictor
from torchvision.models.detection.mask_rcnn import MaskRCNNPredictor
from pycocotools.coco import COCO
from torch.utils.data import Dataset, DataLoader

DATASET_ROOT = "/kaggle/input/datasets/harishrajta/merged-yolo-dataset/Merged_YOLO_Dataset"
IMG_DIR_TRAIN = os.path.join(DATASET_ROOT, "images/train")
ANN_FILE_TRAIN = os.path.join(DATASET_ROOT, "Alternative_Labels/COCO/train_annotations.json")
SAVE_MODEL_PATH = os.path.join("/kaggle/working", "maskrcnn_best.pth")

DEVICE = torch.device("cuda" if torch.cuda.is_available() else "cpu")

class LandslideCOCODataset(Dataset):
    def __init__(self, images_dir, annotation_file):
        self.images_dir = images_dir
        self.coco = COCO(annotation_file)
        
        valid_ids = []
        for img_id in self.coco.imgs.keys():
            path = self.coco.loadImgs(img_id)[0]['file_name']
            full_path = os.path.join(images_dir, path)
            if os.path.exists(full_path):
                valid_ids.append(img_id)
                
        self.ids = list(sorted(valid_ids))

    def __getitem__(self, index):
        coco = self.coco
        img_id = self.ids[index]
        ann_ids = coco.getAnnIds(imgIds=img_id)
        coco_annotation = coco.loadAnns(ann_ids)

        path = coco.loadImgs(img_id)[0]['file_name']
        img_path = os.path.join(self.images_dir, path)
        
        img = cv2.imread(img_path)
        img = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)
        img = cv2.resize(img, (800, 800))
        img_tensor = torchvision.transforms.functional.to_tensor(img)

        boxes, labels, masks = [], [], []

        for i in range(len(coco_annotation)):
            raw_mask = coco.annToMask(coco_annotation[i])
            resized_mask = cv2.resize(raw_mask, (800, 800), interpolation=cv2.INTER_NEAREST)
            
            pos = np.where(resized_mask > 0)
            if pos[0].size == 0 or pos[1].size == 0: continue

            xmin, xmax = np.min(pos[1]), np.max(pos[1])
            ymin, ymax = np.min(pos[0]), np.max(pos[0])
            
            if xmax > xmin and ymax > ymin:
                boxes.append([xmin, ymin, xmax, ymax])
                labels.append(coco_annotation[i]['category_id'])
                masks.append(resized_mask)

        if len(boxes) > 0:
            boxes = torch.as_tensor(boxes, dtype=torch.float32)
            labels = torch.as_tensor(labels, dtype=torch.int64)
            masks = torch.as_tensor(np.array(masks), dtype=torch.uint8)
        else:
            boxes = torch.empty((0, 4), dtype=torch.float32)
            labels = torch.empty((0,), dtype=torch.int64)
            masks = torch.empty((0, 800, 800), dtype=torch.uint8)

        target = {"boxes": boxes, "labels": labels, "masks": masks, "image_id": torch.tensor([img_id])}
        return img_tensor, target

    def __len__(self):
        return len(self.ids)

def collate_fn(batch):
    return tuple(zip(*batch))

def get_model_instance_segmentation(num_classes):
    model = torchvision.models.detection.maskrcnn_resnet50_fpn(weights="DEFAULT")
    in_features = model.roi_heads.box_predictor.cls_score.in_features
    model.roi_heads.box_predictor = FastRCNNPredictor(in_features, num_classes)
    in_features_mask = model.roi_heads.mask_predictor.conv5_mask.in_channels
    model.roi_heads.mask_predictor = MaskRCNNPredictor(in_features_mask, 256, num_classes)
    return model

dataset_train = LandslideCOCODataset(IMG_DIR_TRAIN, ANN_FILE_TRAIN)
data_loader_train = DataLoader(dataset_train, batch_size=2, shuffle=True, collate_fn=collate_fn)

model = get_model_instance_segmentation(4).to(DEVICE)
optimizer = torch.optim.SGD([p for p in model.parameters() if p.requires_grad], lr=0.001, momentum=0.9, weight_decay=0.0005)

best_loss = float('inf')
epochs_no_improve = 0

for epoch in range(100):
    model.train()
    epoch_loss = 0.0
    
    for images, targets in data_loader_train:
        images = list(image.to(DEVICE) for image in images)
        targets = [{k: v.to(DEVICE) for k, v in t.items()} for t in targets]
        
        loss_dict = model(images, targets)
        losses = sum(loss for loss in loss_dict.values())
        
        optimizer.zero_grad()
        losses.backward()
        optimizer.step()
        epoch_loss += losses.item()
        
    avg_loss = epoch_loss / len(data_loader_train)
    if avg_loss < best_loss:
        best_loss = avg_loss
        torch.save(model.state_dict(), SAVE_MODEL_PATH)
        epochs_no_improve = 0
    else:
        epochs_no_improve += 1
        if epochs_no_improve >= 20:
            break

