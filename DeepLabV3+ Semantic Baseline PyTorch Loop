import os
import cv2
import time
import torch
import numpy as np
import segmentation_models_pytorch as smp
import albumentations as A
from albumentations.pytorch import ToTensorV2
from torch.utils.data import Dataset, DataLoader
from torch.nn import CrossEntropyLoss
from torch.optim import Adam

DATASET_ROOT = "/kaggle/input/datasets/harishrajta/merged-yolo-dataset/Merged_YOLO_Dataset"
IMG_DIR_TRAIN = os.path.join(DATASET_ROOT, "images/train/")
MASK_DIR_TRAIN = os.path.join(DATASET_ROOT, "Alternative_Labels/UNet_Masks/train/")
IMG_DIR_VAL = os.path.join(DATASET_ROOT, "images/val/")
MASK_DIR_VAL = os.path.join(DATASET_ROOT, "Alternative_Labels/UNet_Masks/val/")
SAVE_MODEL_PATH = os.path.join("/kaggle/working", "deeplabv3plus_best.pth")   # <-- was unet_best.pth

EPOCHS = 100          
BATCH_SIZE = 4        
LEARNING_RATE = 1e-3
IMAGE_SIZE = 800    
NUM_CLASSES = 4
PATIENCE = 20
DEVICE = torch.device("cuda" if torch.cuda.is_available() else "cpu")

class LandslideKaggleDataset(Dataset):
    def __init__(self, images_dir, masks_dir, transform=None):
        self.images_dir = images_dir
        self.masks_dir = masks_dir
        self.transform = transform
        self.images = [f for f in os.listdir(images_dir) if f.endswith(('.jpg', '.jpeg', '.png'))]

    def __len__(self):
        return len(self.images)

    def __getitem__(self, idx):
        img_name = self.images[idx]
        img_path = os.path.join(self.images_dir, img_name)
        image = cv2.imread(img_path)
        image = cv2.cvtColor(image, cv2.COLOR_BGR2RGB)

        mask_name = img_name.rsplit('.', 1)[0] + '.png'
        mask_path = os.path.join(self.masks_dir, mask_name)

        if os.path.exists(mask_path):
            mask = cv2.imread(mask_path, cv2.IMREAD_GRAYSCALE)
        else:
            mask = np.zeros(image.shape[:2], dtype=np.uint8)

        if self.transform:
            augmented = self.transform(image=image, mask=mask)
            image = augmented['image']
            mask = augmented['mask']

        mask = mask.long()
        return image, mask

transform = A.Compose([
    A.Resize(height=IMAGE_SIZE, width=IMAGE_SIZE),
    A.Normalize(mean=(0.485, 0.456, 0.406), std=(0.229, 0.224, 0.225)),
    ToTensorV2(),
])

train_dataset = LandslideKaggleDataset(IMG_DIR_TRAIN, MASK_DIR_TRAIN, transform=transform)
val_dataset = LandslideKaggleDataset(IMG_DIR_VAL, MASK_DIR_VAL, transform=transform)
train_loader = DataLoader(train_dataset, batch_size=BATCH_SIZE, shuffle=True, num_workers=2)
val_loader = DataLoader(val_dataset, batch_size=BATCH_SIZE, shuffle=False, num_workers=2)


model = smp.DeepLabV3Plus(
    encoder_name="resnet34",
    encoder_weights="imagenet",
    in_channels=3,
    classes=NUM_CLASSES,
).to(DEVICE)


criterion = CrossEntropyLoss()
optimizer = Adam(model.parameters(), lr=LEARNING_RATE)

best_val_loss = float('inf')
epochs_no_improve = 0

for epoch in range(EPOCHS):
    model.train()
    for images, masks in train_loader:
        images, masks = images.to(DEVICE), masks.to(DEVICE)
        optimizer.zero_grad()
        outputs = model(images)
        loss = criterion(outputs, masks)
        loss.backward()
        optimizer.step()

    model.eval()
    val_loss = 0.0
    with torch.no_grad():
        for images, masks in val_loader:
            images, masks = images.to(DEVICE), masks.to(DEVICE)
            outputs = model(images)
            loss = criterion(outputs, masks)
            val_loss += loss.item()

    avg_val_loss = val_loss / len(val_loader)
    if avg_val_loss < best_val_loss:
        best_val_loss = avg_val_loss
        torch.save(model.state_dict(), SAVE_MODEL_PATH)
        epochs_no_improve = 0
    else:
        epochs_no_improve += 1
    if epochs_no_improve >= PATIENCE:
        break
